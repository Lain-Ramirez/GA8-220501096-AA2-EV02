# Compilaciones de Gradle
/build
/aplicacion/build

# Estado local de Gradle
.gradle/

# Sesiones del compilador de Kotlin. Las escribe cada compilacion y no describen el proyecto:
# versionadas, cada build de cada maquina ensucia el estado del repositorio con un archivo nuevo.
.kotlin/

# Ruta del SDK de esta maquina: la escribe Android Studio y no vale para otra
local.properties

# Configuracion del IDE
.idea/
*.iml

# Capturas y compilacion nativa
/captures
.externalNativeBuild
.cxx

# Firma del APK de entrega. Los dos archivos NO viven igual:
#
#   - El almacen (*.jks) se guarda FUERA del arbol del repositorio. Estas reglas son la red por
#     si alguien lo copia aqui sin darse cuenta.
#   - clave_firma.properties SI vive dentro, junto a settings.gradle.kts, para que Gradle lo
#     encuentre por ruta relativa. Lleva las contrasenas en claro, asi que no se versiona jamas.
#
# Quien clone el repositorio no tendra ninguno de los dos: podra compilar en depuracion, y
# assembleRelease se detendra diciendo que falta el archivo. Es lo que se quiere: un APK de
# entrega sin firmar no sirve para nada.
*.jks
*.keystore
clave_firma.properties

# APK compilados sueltos en la raiz. La entrega NO se versiona: se publica como asset de una
# release (v1.0 en adelante), que acepta cualquier tipo de archivo y da un enlace estable. Un APK
# en el repositorio se queda viejo en cuanto cambia el codigo —paso con el de 2cebe5c, anterior al
# #21— y cada version nueva engordaria el historial con cinco megas que no se pueden borrar.
/*.apk
