<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos de la ficha de la parada. Existen para que las seis filas de la ficha se escriban una
    vez: cada fila es una etiqueta y un valor, y sin esto el layout repetiria los mismos seis
    atributos doce veces.
-->
<resources>

    <style name="Menu08.FilaFicha" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Menu08.EtiquetaFicha" parent="">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Menu08.ValorFicha" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!--
        La accion de un aviso: los ajustes de la aplicacion y los de ubicacion del telefono.

        Un boton delineado se pinta por omision con colorPrimary, que es el color del contenido
        sobre la superficie de la pantalla. Estos dos van dentro de un bloque de colorErrorContainer,
        y ahi el color de contenido que le toca a Material 3 es colorOnErrorContainer: el texto y el
        trazo salen del mismo par que el resto del aviso en vez de traerse el rojo de la marca a un
        fondo que no es el suyo.
    -->
    <style name="Menu08.AccionAviso" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
        <item name="strokeColor">?attr/colorOnErrorContainer</item>
    </style>

    <!-- Los cuatro avisos y la nota del permiso: mismo bloque, distinto fondo. -->
    <style name="Menu08.Aviso" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

</resources>
